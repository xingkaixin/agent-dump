---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import {
  getGuides,
  guidePaths,
  guideIndexPaths,
  guideUi,
  type Guide,
} from "../lib/guides";
import { site, ui } from "../lib/i18n";
import "../styles/guides.css";

interface Props {
  frontmatter: Guide;
  headings: { depth: number; slug: string; text: string }[];
}
const { frontmatter: guide, headings } = Astro.props;
const { locale, title, description, slug, updated } = guide;
const t = guideUi[locale];
const titleWords = locale === "zh"
  ? [...new Intl.Segmenter("zh", { granularity: "word" }).segment(title)]
  : null;
const paths = await guidePaths(slug);
const related = (await getGuides(locale))
  .filter((entry) => entry.slug !== slug)
  .sort(
    (a, b) =>
      Number(b.category === guide.category) -
      Number(a.category === guide.category),
  )
  .slice(0, 2);
const breadcrumbs = [
  { name: t.home, path: site.paths[locale] },
  { name: t.label, path: guideIndexPaths[locale] },
  { name: title, path: paths[locale]! },
];
const sections = [
  ...headings.filter((heading) => heading.depth === 2),
  ...(guide.faq?.length ? [{ depth: 2, slug: "faq", text: t.faqHeading }] : []),
];
const quickInstallMethods = [
  { label: "Homebrew", code: "brew install xingkaixin/tap/agent-dump" },
  {
    label: "curl",
    code: "curl -sSfL https://github.com/xingkaixin/agent-dump/releases/latest/download/install.sh | sh",
  },
  { label: "npx", code: "npx @agent-dump/cli list --days 30" },
  { label: "uv", code: "uv tool install agent-dump" },
];
const steps = sections.flatMap((heading) => {
  const match = heading.text.match(/^(\d+)\.\s+(.+)$/);
  return match ? [{ slug: heading.slug, number: match[1], text: match[2] }] : [];
});
const content = (await Astro.slots.render("default")).replace(
  /(<h2 id="[^"]*">)(\d+)\.\s+/g,
  '$1<span class="no">$2</span>',
);
---

<Base
  locale={locale}
  page={{
    title: `${title} | Agent Dump`,
    description,
    paths,
    article: { updated },
    breadcrumbs,
    faq: guide.faq,
  }}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <Header locale={locale} paths={paths} homeLinks current="guides" />
  <main id="main" tabindex="-1">
    <header class="ghead dots">
      <div class="wrap rise">
        <nav
          class="crumb"
          aria-label={
            locale === "zh"
              ? "面包屑导航"
              : locale === "ja"
                ? "パンくずリスト"
                : "Breadcrumb"
          }
        >
          <a href={site.paths[locale]}>{t.home}</a>
          <span aria-hidden="true">/</span>
          <a href={guideIndexPaths[locale]}>{t.label}</a>
        </nav>
        <p class="gcat">{t.categories[guide.category]}</p>
        <h1 class="gt">
          {titleWords
            ? titleWords.map(({ segment, isWordLike }) =>
                isWordLike ? <span class="title-word">{segment}</span> : segment,
              )
            : title}
        </h1>
        <p class="deck">{description}</p>
        <p class="meta">
          <a href={site.blogUrl[locale]} target="_blank" rel="noopener">
            <span class="ava" aria-hidden="true">{site.author.name[0].toUpperCase()}</span>
            {site.author.name}
          </a>
          <span class="sep" aria-hidden="true"></span>
          <span>{t.updated} <time datetime={updated}>{updated}</time></span>
        </p>
        {steps.length > 0 && (
          <ol class="steps">
            {steps.map((step) => (
              <li>
                <a href={`#${step.slug}`}>
                  <b>STEP {step.number.padStart(2, "0")}</b>
                  {step.text}
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>
    </header>
    <div class="wrap gbody">
      <article>
        <div
          class="prose guide-content"
          data-guide-slug={slug}
          data-copy={ui[locale].copy}
          data-copied={ui[locale].copied}
          data-copy-error={
            locale === "zh"
              ? "复制失败，请手动选择命令"
              : locale === "ja"
                ? "コピーに失敗しました。コマンドを手動で選択してください。"
                : "Copy failed. Select the command manually."
          }
          set:html={content}
        />
        {guide.faq && guide.faq.length > 0 && (
          <section class="guide-faq" id="faq" aria-labelledby="guide-faq-heading">
            <h2 id="guide-faq-heading">{t.faqHeading}</h2>
            <dl class="gfaq-list">
              {guide.faq.map((item) => (
                <div class="gfaq-item">
                  <dt>{item.question}</dt>
                  <dd>{item.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
        <section
          class="guide-install"
          aria-labelledby="guide-install-heading"
          data-guide-install
          data-guide-slug={slug}
          data-copy-label={ui[locale].copy}
          data-copied-label={ui[locale].copied}
        >
          <div class="ginst-head">
            <div>
              <h2 id="guide-install-heading">{t.quickInstallTitle}</h2>
              <p>{t.quickInstallNote}</p>
            </div>
            <a
              class="tlink"
              href={`${site.paths[locale]}#install`}
              data-umami-event="install-cta"
              data-umami-event-location="guide"
              data-umami-event-locale={ui[locale].htmlLang}
            >
              {t.allInstallOptions}
              <Icon name="arrowRight" small />
            </a>
          </div>
          <div class="ginst-tabs" role="group" aria-label={t.quickInstallTitle}>
            {quickInstallMethods.map((method, index) => (
              <button
                type="button"
                class="ginst-tab"
                aria-pressed={index === 0 ? "true" : "false"}
                data-ginst-opt={method.label}
                data-ginst-code={method.code}
              >
                {method.label}
              </button>
            ))}
          </div>
          <div class="ginst-cmd">
            <span class="ginst-sig" aria-hidden="true">$</span>
            <code data-ginst-display>{quickInstallMethods[0].code}</code>
            <button
              type="button"
              class="cbtn"
              data-ginst-copy
              data-copy-text={quickInstallMethods[0].code}
              data-install-method={quickInstallMethods[0].label}
              aria-label={ui[locale].copy}
            >
              {ui[locale].copy}
            </button>
            <span role="status" aria-live="polite" class="sr-only" data-ginst-status></span>
          </div>
          <div class="ginst-companion">
            <span>{t.companionPrompt}</span>
            <a
              class="tlink"
              href={site.codesesh}
              target="_blank"
              rel="noopener"
              data-umami-event="outbound-click"
              data-umami-event-destination="CodeSesh"
              data-umami-event-location="guide"
              data-umami-event-locale={ui[locale].htmlLang}
            >
              {t.companionAction}
              <Icon name="arrowUpRight" small />
            </a>
          </div>
        </section>
        <section class="related" aria-labelledby="related-heading">
          <h2 id="related-heading">{t.related}</h2>
          <div class="relgrid">
            {related.map((entry) => (
              <div class="gwrap">
                <a class="relcard" href={entry.href}>
                  <span>{t.categories[entry.category]}</span>
                  {entry.title}
                  {entry.locale !== locale && locale === "ja" ? "（英語）" : ""}
                </a>
              </div>
            ))}
          </div>
        </section>
      </article>
      <aside class="aside">
        <div class="toc">
          <nav aria-label={t.contents} class="guide-toc">
            <p>{t.contents}</p>
            {sections.map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
          <a class="all" href={guideIndexPaths[locale]}>
            {t.all}
            <Icon name="arrowUpRight" small />
          </a>
        </div>
      </aside>
    </div>
  </main>
  <Footer locale={locale} />
</Base>

<script>
  const progress = document.querySelector<HTMLElement>(".reading-progress");
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".guide-toc a")];
  const targets = links.map((link) =>
    document.getElementById(decodeURIComponent(link.hash.slice(1))),
  );
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    progress?.style.setProperty(
      "--progress",
      String(max > 0 ? Math.min(1, window.scrollY / max) : 0),
    );
    let current = 0;
    targets.forEach((target, index) => {
      if (target && target.getBoundingClientRect().top < 140) current = index;
    });
    links.forEach((link, index) => {
      if (index === current) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };
  update();
  window.addEventListener("scroll", update, { passive: true });
</script>

<script>
  import { copyText } from "../lib/clipboard";
  import { trackEvent } from "../lib/analytics";
  const content = document.querySelector<HTMLElement>(".guide-content");
  if (content) {
    const guideSlug = content.dataset.guideSlug ?? "";
    const nearestHeadingId = (node: Element) => {
      let current = node.previousElementSibling;
      while (current) {
        if (current.tagName === "H2" && current.id) return current.id;
        current = current.previousElementSibling;
      }
      return "intro";
    };
    for (const pre of content.querySelectorAll("pre")) {
      const command = pre.querySelector("code")?.textContent;
      if (!command) continue;
      const target = nearestHeadingId(pre);
      const wrapper = document.createElement("div");
      wrapper.className = "guide-code";
      pre.before(wrapper);
      const bar = document.createElement("div");
      bar.className = "gcode-bar";
      const language = document.createElement("span");
      language.textContent = pre.dataset.language ?? "sh";
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = content.dataset.copy!;
      button.className = "cbtn guide-copy";
      bar.append(language, button);
      const status = document.createElement("span");
      status.className = "sr-only";
      status.setAttribute("role", "status");
      wrapper.append(bar, pre, status);
      let reset: ReturnType<typeof setTimeout>;
      button.addEventListener("click", async () => {
        try {
          if (!(await copyText(command))) throw new Error("Copy rejected");
          status.textContent = content.dataset.copied!;
          button.textContent = content.dataset.copied!;
          button.classList.add("ok");
          clearTimeout(reset);
          reset = setTimeout(() => {
            button.textContent = content.dataset.copy!;
            button.classList.remove("ok");
            status.textContent = "";
          }, 2000);
          trackEvent("guide-copy", {
            ...(guideSlug ? { guide: guideSlug } : {}),
            target,
          });
        } catch {
          status.textContent = content.dataset.copyError!;
        }
      });
    }
  }

  for (const box of document.querySelectorAll<HTMLElement>("[data-guide-install]")) {
    const guideSlug = box.dataset.guideSlug ?? "";
    const copyLabel = box.dataset.copyLabel ?? "Copy";
    const copiedLabel = box.dataset.copiedLabel ?? "Copied";
    const tabs = [...box.querySelectorAll<HTMLButtonElement>("[data-ginst-opt]")];
    const codeEl = box.querySelector<HTMLElement>("[data-ginst-display]");
    const copyBtn = box.querySelector<HTMLButtonElement>("[data-ginst-copy]");
    const statusEl = box.querySelector<HTMLElement>("[data-ginst-status]");
    let timer = 0;

    const resetBtn = () => {
      if (!copyBtn) return;
      copyBtn.textContent = copyLabel;
      copyBtn.classList.remove("ok");
      copyBtn.setAttribute("aria-label", copyLabel);
      if (statusEl) statusEl.textContent = "";
    };

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const label = tab.dataset.ginstOpt ?? "";
        const code = tab.dataset.ginstCode ?? "";
        for (const other of tabs) {
          other.setAttribute("aria-pressed", String(other === tab));
        }
        if (codeEl) codeEl.textContent = code;
        if (copyBtn) {
          copyBtn.dataset.copyText = code;
          copyBtn.dataset.installMethod = label;
          window.clearTimeout(timer);
          resetBtn();
        }
      });
    }

    copyBtn?.addEventListener("click", async () => {
      const text = copyBtn.dataset.copyText ?? "";
      try {
        if (!(await copyText(text))) return;
        copyBtn.textContent = copiedLabel;
        copyBtn.classList.add("ok");
        copyBtn.setAttribute("aria-label", copiedLabel);
        if (statusEl) statusEl.textContent = copiedLabel;
        window.clearTimeout(timer);
        timer = window.setTimeout(resetBtn, 1600);
        const method = copyBtn.dataset.installMethod;
        if (method) {
          trackEvent("install-copy", {
            method,
            location: "guide",
            ...(guideSlug ? { guide: guideSlug } : {}),
          });
        }
      } catch {
        /* clipboard unavailable */
      }
    });
  }
</script>
