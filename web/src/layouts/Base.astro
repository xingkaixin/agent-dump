---
import "../fonts/fonts.css";
import sansCore from "../fonts/sans-core.woff2?url";
import mono300 from "../fonts/mono-300-core.woff2?url";
import mono400 from "../fonts/mono-400-core.woff2?url";
import mono500 from "../fonts/mono-500-core.woff2?url";
import mono600 from "../fonts/mono-600-core.woff2?url";
import "../styles/global.css";
import { site, ui, LOCALES, type Locale } from "../lib/i18n";
import { version } from "../lib/version";

interface Props {
  locale: Locale;
  noindex?: boolean;
  page?: {
    title: string;
    description: string;
    paths: Partial<Record<Locale, string>>;
    article?: { updated: string };
    breadcrumbs?: { name: string; path: string }[];
    faq?: { question: string; answer: string }[];
  };
}

const { locale, page, noindex = false } = Astro.props;
const t = ui[locale];
const paths = page?.paths ?? site.paths;
const canonical = new URL(paths[locale]!, site.origin).href;
const title = page?.title ?? t.title;
const description = page?.description ?? t.description;
const ogImage = new URL(site.ogImage.path, site.origin).href;

const alternates = [
  ...LOCALES.filter((loc) => paths[loc]).map((loc) => ({
    hreflang: ui[loc].htmlLang,
    href: new URL(paths[loc]!, site.origin).href,
  })),
  { hreflang: "x-default", href: new URL(paths.en!, site.origin).href },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site.origin}/#author`,
      name: site.author.name,
      url: site.author.url,
      sameAs: [site.author.github],
    },
    {
      "@type": "WebSite",
      "@id": `${site.origin}/#website`,
      name: "Agent Dump",
      url: site.origin,
      inLanguage: t.htmlLang,
      description: t.websiteDescription,
      publisher: { "@id": `${site.origin}/#author` },
    },
    ...(page?.article
      ? [
          {
            "@type": "Article",
            "@id": `${canonical}#article`,
            headline: page.title.replace(/ \| Agent Dump$/, ""),
            description,
            inLanguage: t.htmlLang,
            dateModified: page.article.updated,
            mainEntityOfPage: { "@id": canonical },
            author: { "@id": `${site.origin}/#author` },
            publisher: { "@id": `${site.origin}/#author` },
          },
        ]
      : []),
    ...(page?.breadcrumbs
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: page.breadcrumbs.map((crumb, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: crumb.name,
              item: new URL(crumb.path, site.origin).href,
            })),
          },
        ]
      : []),
    ...(page?.faq?.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${canonical}#faq`,
            inLanguage: t.htmlLang,
            mainEntity: page.faq.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: { "@type": "Answer", text: item.answer },
            })),
          },
        ]
      : []),
    ...(page
      ? [
          {
            "@type": "WebPage",
            "@id": canonical,
            url: canonical,
            name: title,
            description,
            inLanguage: t.htmlLang,
            isPartOf: { "@id": `${site.origin}/#website` },
            author: { "@id": `${site.origin}/#author` },
          },
        ]
      : [
          {
            "@type": "SoftwareApplication",
            "@id": `${site.origin}/#software`,
            name: "Agent Dump",
            applicationCategory: "DeveloperApplication",
            applicationSubCategory: "Command-line developer tool",
            operatingSystem: "macOS, Linux, Windows",
            description: t.softwareDescription,
            inLanguage: t.htmlLang,
            url: canonical,
            downloadUrl: site.downloadUrls,
            softwareVersion: version,
            offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
            author: { "@id": `${site.origin}/#author` },
            codeRepository: site.repo,
            license: site.license,
          },
          {
            "@type": "FAQPage",
            "@id": `${canonical}#faq`,
            inLanguage: t.htmlLang,
            mainEntity: t.faq.map((item) => ({
              "@type": "Question",
              name: item.question,
              acceptedAnswer: { "@type": "Answer", text: item.answer },
            })),
          },
        ]),
  ],
};
---

<!doctype html>
<html lang={t.htmlLang} dir={t.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {[sansCore, mono300, mono400, mono500, mono600].map((href) => (
      <link
        rel="preload"
        href={href}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    ))}
    <meta name="theme-color" content="#fcfdfc" />
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <title>{title}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="icon" type="image/png" href={site.logo} />
    <link rel="apple-touch-icon" href={site.logo} />

    <!-- Open Graph -->
    <meta property="og:type" content={page?.article ? "article" : "website"} />
    {page?.article && (
      <meta property="article:modified_time" content={page.article.updated} />
    )}
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Agent Dump" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={t.ogImageAlt} />
    <meta property="og:locale" content={t.ogLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogImageAlt} />

    {!noindex && <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />}
    {!noindex && <script
      is:inline
      defer
      src="https://umami.xingkaixin.me/script.js"
      data-website-id="7141781d-b011-454b-a16b-8c1e524140c6"
      data-domains="agent-dump.xingkaixin.me"
      data-exclude-hash="true"
      data-performance="true"
    ></script>}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        var theme = "light";
        try {
          var stored = localStorage.getItem("agent-dump-theme");
          theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch (e) {}
        root.setAttribute("data-theme", theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta)
          meta.setAttribute(
            "content",
            theme === "dark" ? "#0c100f" : "#fcfdfc",
          );
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skipLink}</a>
    {locale === "en" && !noindex && (paths.zh || paths.ja) && (
      <>
        <aside class="locale-banner" data-locale-banner aria-label="Language suggestion" hidden>
          <div class="wrap locale-banner-in">
            <span data-locale-message></span>
            <div class="locale-banner-acts">
              <a class="locale-banner-go" data-locale-link href="/"></a>
              <button type="button" class="locale-banner-close" data-locale-dismiss aria-label="Dismiss">&times;</button>
            </div>
          </div>
        </aside>
        <script
          is:inline
          define:vars={{ targets: { zh: paths.zh ?? null, ja: paths.ja ?? null } }}
        >
          (function () {
            try {
              if (localStorage.getItem("agent-dump-locale")) return;
              var langs = navigator.languages && navigator.languages.length
                ? navigator.languages
                : [navigator.language || ""];
              var matched = null;
              for (var i = 0; i < langs.length; i++) {
                var tag = String(langs[i]).toLowerCase();
                var code = tag.indexOf("zh") === 0 ? "zh"
                  : tag.indexOf("ja") === 0 ? "ja"
                  : tag.indexOf("en") === 0 ? "en" : null;
                if (!code) continue;
                if (targets[code]) matched = code;
                break;
              }
              if (!matched) return;
              var banner = document.querySelector("[data-locale-banner]");
              if (!banner) return;
              var copy = {
                zh: { msg: "此页面提供中文版本。", cta: "切换到中文", lang: "zh-Hans" },
                ja: { msg: "このページは日本語でも読めます。", cta: "日本語で読む", lang: "ja" },
              }[matched];
              var msgEl = banner.querySelector("[data-locale-message]");
              var linkEl = banner.querySelector("[data-locale-link]");
              var closeEl = banner.querySelector("[data-locale-dismiss]");
              if (!msgEl || !linkEl || !closeEl) return;
              msgEl.textContent = copy.msg;
              linkEl.textContent = copy.cta;
              linkEl.setAttribute("lang", copy.lang);
              linkEl.setAttribute("href", targets[matched] + location.search + location.hash);
              linkEl.addEventListener("click", function () {
                try { localStorage.setItem("agent-dump-locale", matched); } catch (e) {}
              });
              closeEl.addEventListener("click", function () {
                banner.hidden = true;
                try { localStorage.setItem("agent-dump-locale", "en"); } catch (e) {}
              });
              banner.hidden = false;
            } catch (e) {}
          })();
        </script>
      </>
    )}
    <slot />
  </body>
</html>
