---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import { getGuides, guideIndexPaths, guideUi } from "../lib/guides";
import { site, type Locale } from "../lib/i18n";
import "../styles/guides.css";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = guideUi[locale];
const guides = await getGuides(locale);
const categories = Object.entries(t.categories).map(([key, label]) => ({
  key,
  label,
  count: guides.filter((guide) => guide.category === key).length,
}));
const most = Math.max(...categories.map((category) => category.count));
---

<Base
  locale={locale}
  page={{
    title: `${t.seoTitle} | Agent Dump`,
    description: t.description,
    paths: guideIndexPaths,
    breadcrumbs: [
      { name: t.home, path: site.paths[locale] },
      { name: t.label, path: guideIndexPaths[locale] },
    ],
  }}
>
  <Header locale={locale} paths={guideIndexPaths} homeLinks current="guides" />
  <main id="main" tabindex="-1">
    <section class="ghero dots">
      <div class="wrap">
        <nav class="crumb" aria-label={locale === "zh" ? "面包屑导航" : "Breadcrumb"}>
          <a href={site.paths[locale]}>{t.home}</a>
          <span aria-hidden="true">/</span>
          <span>{t.label}</span>
        </nav>
        <div class="ghero-grid">
          <div class="rise">
            <p class="eyebrow"><span class="ix">06</span><span class="ln"></span>{t.label}</p>
            <h1 class="gh1">{t.title}</h1>
            <p class="gdesc">{t.description}</p>
            <p class="gnote"><Icon name="arrowRight" small />{t.note}</p>
          </div>
          <div class="cats rise" style="animation-delay: 0.1s" aria-hidden="true">
            {categories.map((category, index) => (
              <div class="catrow">
                <span>{category.label}</span>
                <b>{category.count}</b>
                <span class="catbar">
                  <i
                    style={`width: ${(category.count / most) * 100}%; animation-delay: ${index * 0.08}s`}
                  ></i>
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="bar guide-filters" data-guide-filters hidden>
      <div class="wrap bar-in">
        <div role="group" aria-label={t.filter} class="fbtns">
          <button type="button" class="fbtn" data-category="all" aria-pressed="true">
            {t.all}<span aria-hidden="true">{guides.length}</span>
          </button>
          {categories.map((category) => (
            <button
              type="button"
              class="fbtn"
              data-category={category.key}
              aria-pressed="false"
            >
              {category.label}<span aria-hidden="true">{category.count}</span>
            </button>
          ))}
        </div>
        <label class="search">
          <Icon name="search" />
          <span class="sr-only">{t.search}</span>
          <input type="search" placeholder={t.search} />
        </label>
      </div>
    </div>

    <section class="glist">
      <div class="wrap">
        <p
          class="count"
          data-count={t.count}
          data-found={t.found}
        >
          {t.count.replace("{count}", String(guides.length))}
        </p>
        <div class="guide-grid">
          {guides.map((guide, index) => (
            <article
              class="gwrap guide-card"
              data-guide-card
              data-category={guide.category}
              style={`animation-delay: ${index * 0.045}s`}
            >
              <a class="gcard" href={guide.href}>
                <span class="gno" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="gcat">{t.categories[guide.category]}</span>
                <h2>{guide.title}</h2>
                <p>{guide.description}</p>
                <span class="gfoot">
                  {t.read}
                  <Icon name="arrowUpRight" />
                </span>
              </a>
            </article>
          ))}
        </div>
        <div class="empty guide-no-results" role="status" hidden>
          <span class="ei"><Icon name="search" /></span>
          <p>{t.empty}</p>
          <button type="button" class="btn btn-ghost btn-sm" data-guide-clear>
            {t.clear}
          </button>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</Base>

<script>
  const filters = document.querySelector<HTMLElement>("[data-guide-filters]");
  if (filters) {
    filters.hidden = false;
    const input = filters.querySelector<HTMLInputElement>("input")!;
    const buttons = [
      ...filters.querySelectorAll<HTMLButtonElement>("button[data-category]"),
    ];
    const cards = [
      ...document.querySelectorAll<HTMLElement>("[data-guide-card]"),
    ];
    const count = document.querySelector<HTMLElement>(".count")!;
    const empty = document.querySelector<HTMLElement>(".guide-no-results")!;
    let category = "all";
    function update() {
      const query = input.value.trim().toLocaleLowerCase();
      for (const card of cards) {
        card.hidden =
          (category !== "all" && card.dataset.category !== category) ||
          !card.textContent?.toLocaleLowerCase().includes(query);
      }
      const shown = cards.filter((card) => !card.hidden).length;
      empty.hidden = shown > 0;
      count.textContent = (
        shown === cards.length ? count.dataset.count! : count.dataset.found!
      )
        .replace("{count}", String(shown))
        .replace("{total}", String(cards.length));
    }
    function select(next: string) {
      category = next;
      for (const item of buttons)
        item.setAttribute("aria-pressed", String(item.dataset.category === next));
      update();
    }
    for (const button of buttons) {
      button.addEventListener("click", () => select(button.dataset.category!));
    }
    input.addEventListener("input", update);
    document
      .querySelector("[data-guide-clear]")!
      .addEventListener("click", () => {
        input.value = "";
        select("all");
      });
  }
</script>
