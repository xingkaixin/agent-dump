---
import type { Locale } from "../lib/i18n";
import { landing } from "../lib/landing";
import Icon from "./Icon.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const a = landing[locale].audience;
const developerCommands = [
  "agent-dump --browse --time-field updated --days 7",
  "agent-dump search 'auth timeout' --query 'path:.' --days 30",
  "agent-dump export codex://SESSION_ID --format markdown --output ./sessions",
];
const agentSteps = [
  { command: "providers --json", note: a.agent.steps[0] },
  { command: "list --days 7 --json", note: a.agent.steps[1] },
  { command: "read-prompt <uri>", note: a.agent.steps[2] },
];
---

<section id="agents" class="sec panel">
  <div class="wrap">
    <div data-reveal>
      <p class="eyebrow"><span class="ix">04</span><span class="ln"></span>{a.tag}</p>
      <h2 class="aud-h">{a.headingLead}<span class="tail">{a.headingTail}</span></h2>
    </div>
    <div class="aud">
      <article class="acard" data-reveal>
        <span class="tag">{a.developer.tag}</span>
        <h3>{a.developer.title}</h3>
        <p class="bd">{a.developer.body}</p>
        <ol class="dsteps">
          {developerCommands.map((command, index) => (
            <li>
              <p class="lbl">
                <span class="kbd">0{index + 1}</span>{a.developer.steps[index]}
              </p>
              <p class="cbox"><code>{command}</code></p>
            </li>
          ))}
        </ol>
      </article>
      <article class="acard dk" data-reveal>
        <span class="tag">{a.agent.tag}</span>
        <h3>{a.agent.title}</h3>
        <p class="bd">{a.agent.body}</p>
        <ol class="ladder">
          {agentSteps.map((step, index) => (
            <li>
              <span class="lnum">0{index + 1}</span>
              <div><code>{step.command}</code><span>{step.note}</span></div>
            </li>
          ))}
          <li>
            <span class="lnum">04</span>
            <div>
              <code>follow cursor <Icon name="refresh" small class="spin" /></code>
              <span>until has_more=false</span>
            </div>
          </li>
        </ol>
      </article>
    </div>
  </div>
</section>
