---
import { ui, type Locale } from "../lib/i18n";
import { Faq } from "./Faq";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="faq" class="sec flush">
  <div class="wrap faq">
    <div data-reveal>
      <p class="eyebrow"><span class="ix">09</span><span class="ln"></span>FAQ</p>
      <h2 class="h2">{t.faqHeading}</h2>
    </div>
    <div data-reveal>
      <Faq client:visible items={t.faq} />
    </div>
  </div>
</section>
