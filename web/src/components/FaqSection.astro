---
import { ui, type Locale } from "../lib/i18n";
import Faq from "./Faq.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="faq" class="sec flush">
  <div class="wrap faq">
    <h2 class="h2" data-reveal>{t.faqHeading}</h2>
    <div data-reveal>
      <Faq items={t.faq} />
    </div>
  </div>
</section>
