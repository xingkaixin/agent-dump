---
import { ui, type Locale } from "../lib/i18n";
import { Faq } from "./Faq";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="faq" class="faq-section">
  <div class="shell faq-layout">
    <div data-reveal class="section-heading">
      <h2>
        {t.faqHeading}
      </h2>
    </div>
    <div data-reveal class="faq-panel">
      <Faq client:visible items={t.faq} />
    </div>
  </div>
</section>
