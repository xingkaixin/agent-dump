---
import type { UpdateItem } from "../lib/i18n";
interface Props {
  update: UpdateItem;
}
const { update } = Astro.props;
---

<article class="release-card" data-reveal>
  <header>
    <span>{update.version}</span>
    <time datetime={update.date}>{update.date}</time>
  </header>
  <h3>{update.title}</h3>
  <p>{update.description}</p>
  <div class="tag-list">
    {update.tags.map((tag) => <span>{tag}</span>)}
  </div>
</article>
