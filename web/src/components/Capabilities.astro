---
import { ArrowRightIcon } from "@phosphor-icons/react";
import { ui, type Locale } from "../lib/i18n";
import { getGuides } from "../lib/guides";
import { SessionExplorer } from "./SessionExplorer";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const guides = await getGuides(locale);
const slugs = [
  "search-ai-coding-history",
  "handoff-context-to-ai-agent",
  "export-codex-session",
  "weekly-report-from-ai-sessions",
];
---

<section id="capabilities" class="capabilities-section">
  <div class="shell">
    <div data-reveal class="section-heading section-heading--wide">
      <h2>{t.capabilitiesHeading}</h2>
      <p>{t.answerSummary}</p>
    </div>
    <div data-reveal>
      <SessionExplorer locale={locale} client:load />
    </div>
    <div class="capability-grid">
      {t.capabilities.map((capability, index) => (
        <article data-reveal class="capability-block">
          <h3>{capability.title}</h3>
          <p>{capability.body}</p>
          <code>{capability.command}</code>
          <a
            href={guides.find((guide) => guide.slug === slugs[index])?.href}
            aria-label={`${capability.title}: ${locale === "zh" ? "使用说明" : locale === "ja" ? "ガイド（英語）" : "guide"}`}
          >
            <ArrowRightIcon size={22} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
