---
import { Image } from "astro:assets";
import sessionConvergence from "../assets/editorial/session-convergence.png";
import { terminalScenes, ui, type Locale } from "../lib/i18n";
import Terminal from "./Terminal.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="capabilities" class="capabilities-section">
  <div class="shell">
    <div data-reveal class="section-heading section-heading--wide">
      <h2>
        {t.capabilitiesHeading}
      </h2>
      <p>{t.answerSummary}</p>
    </div>

    <div class="convergence-stage" data-reveal>
      <Image
        src={sessionConvergence}
        alt=""
        aria-hidden="true"
        widths={[640, 960, 1440]}
        sizes="(max-width: 767px) 100vw, 72rem"
        format="webp"
        quality={78}
        loading="lazy"
        class="convergence-image"
      />
      <div class="convergence-terminal">
        <Terminal scene={terminalScenes[1]} label={t.terminalLabel} />
      </div>
    </div>

    <div class="capability-grid">
      {
        t.capabilities.map((capability, index) => (
          <article
            data-reveal
            style={`--reveal-delay: ${index * 60}ms`}
            class:list={["capability-block", `capability-block--${index + 1}`]}
          >
            <h3>{capability.title}</h3>
            <p>{capability.body}</p>
            <div class="command-line">
              <span aria-hidden="true">$</span>
              <code>{capability.command}</code>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
