---
// Astro's prerendered image service needs Sharp declared in this project's build dependencies.
import { Image } from "astro:assets";
import sessionStream from "../assets/backgrounds/session-stream.png";
import sessionArchive from "../assets/backgrounds/session-archive.png";
import type { Locale } from "../lib/i18n";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Providers from "./Providers.astro";
import Capabilities from "./Capabilities.astro";
import UpdatesSection from "./UpdatesSection.astro";
import InstallSection from "./InstallSection.astro";
import FaqSection from "./FaqSection.astro";
import Footer from "./Footer.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Header locale={locale} />
<main id="main" tabindex="-1">
  <div class="section-surface">
    <Image
      src={sessionStream}
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1536]}
      sizes="100vw"
      format="webp"
      quality={75}
      priority
      class="section-artwork section-artwork--hero"
    />
    <Hero locale={locale} />
  </div>
  <div class="section-surface section-surface--providers">
    <Providers locale={locale} />
  </div>
  <div class="section-surface">
    <Image
      src={sessionArchive}
      alt=""
      aria-hidden="true"
      widths={[640, 960, 1536]}
      sizes="100vw"
      format="webp"
      quality={75}
      loading="lazy"
      fetchpriority="low"
      class="section-artwork section-artwork--archive"
    />
    <Capabilities locale={locale} />
  </div>
  <UpdatesSection locale={locale} />
  <div class="section-surface section-surface--install">
    <InstallSection locale={locale} />
  </div>
  <FaqSection locale={locale} />
</main>
<Footer locale={locale} />

<script is:inline>
  (function () {
    var els = document.querySelectorAll("[data-reveal]");
    if (!els.length) return;
    if (!("IntersectionObserver" in window)) {
      els.forEach(function (el) {
        el.classList.add("is-in");
      });
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    els.forEach(function (el) {
      io.observe(el);
    });
  })();
</script>
