---
import type { Locale } from "../lib/i18n";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Providers from "./Providers.astro";
import Capabilities from "./Capabilities.astro";
import BrowseSection from "./BrowseSection.astro";
import AudienceSection from "./AudienceSection.astro";
import BoundarySection from "./BoundarySection.astro";
import GuidesSection from "./GuidesSection.astro";
import InstallSection from "./InstallSection.astro";
import UpdatesSection from "./UpdatesSection.astro";
import FaqSection from "./FaqSection.astro";
import Footer from "./Footer.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Header locale={locale} />
<main id="main" tabindex="-1">
  <Hero locale={locale} />
  <Providers locale={locale} />
  <Capabilities locale={locale} />
  <BrowseSection locale={locale} />
  <AudienceSection locale={locale} />
  <BoundarySection locale={locale} />
  <GuidesSection locale={locale} />
  <InstallSection locale={locale} />
  <UpdatesSection locale={locale} />
  <FaqSection locale={locale} />
</main>
<Footer locale={locale} />

<script is:inline>
  (function () {
    var els = document.querySelectorAll("[data-reveal]");
    if (!els.length) return;
    if (!("IntersectionObserver" in window)) return;
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.remove("reveal-pending");
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    els.forEach(function (el) {
      if (el.getBoundingClientRect().top > window.innerHeight)
        el.classList.add("reveal-pending");
      io.observe(el);
    });
  })();
</script>
