---
import { guideIndexPaths, guideUi } from "../lib/guides";
import { site, ui, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const links = [
  { label: t.footerGithub, href: site.repo },
  { label: "npm", href: site.npm },
  { label: "PyPI", href: site.pypi },
  { label: t.changelogLabel, href: site.changelogUrl[locale] },
];
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <p class="site-footer__brand">
        <img src={site.logo} alt="" width="22" height="22" />
        agent-dump
      </p>
      <p class="site-footer__tagline">{t.footerTagline}</p>
    </div>
    <nav aria-label="Footer" class="site-footer__nav">
      <a href={guideIndexPaths[locale]} class="site-footer__link">
        {guideUi[locale].label}
      </a>
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="site-footer__link"
          data-umami-event="outbound-click"
          data-umami-event-destination={link.label}
          data-umami-event-locale={t.htmlLang}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
