---
import { guideIndexPaths, guideUi } from "../lib/guides";
import { site, ui, type Locale } from "../lib/i18n";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const links = [
  { label: t.footerGithub, href: site.repo },
  { label: "npm", href: site.npm },
  { label: "PyPI", href: site.pypi },
  { label: t.changelogLabel, href: site.changelogUrl[locale] },
];
---

<footer class="ftr">
  <div class="wrap">
    <div class="ftr-in">
      <div>
        <a class="brand" href={site.paths[locale]}>
          <Logo size={24} />
          agent-dump
        </a>
        <p class="tg">{t.footerTagline}</p>
      </div>
      <nav aria-label="Footer" class="fnav">
        <a href={guideIndexPaths[locale]}>{guideUi[locale].label}</a>
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="outbound-click"
            data-umami-event-destination={link.label}
            data-umami-event-locale={t.htmlLang}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
    <p class="giant" aria-hidden="true"><b>$</b> agent-dump<i></i></p>
  </div>
</footer>
