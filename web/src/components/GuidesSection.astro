---
import { ArrowRightIcon } from "@phosphor-icons/react";
import { getGuides, guideIndexPaths, guideUi } from "../lib/guides";
import type { Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = guideUi[locale];
const guides = await getGuides(locale);
---

<section id="guides" class="guides-section">
  <div class="shell">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">{t.label}</p>
        <h2>{t.title}</h2>
      </div>
      <div>
        <p>{t.description}</p>
        <a href={guideIndexPaths[locale]} class="text-link">
          {t.all}
          <ArrowRightIcon size={16} aria-hidden="true" />
        </a>
      </div>
    </div>
    <div class="guide-grid">
      {guides.map((guide, index) => (
        <a href={guide.href} class="guide-tile" data-reveal>
          <span class="guide-tile__meta">
            <span>
              0{index + 1} · {t.categories[guide.category]}
            </span>
            <ArrowRightIcon size={20} aria-hidden="true" className="guide-tile__arrow" />
          </span>
          <h3>{guide.title}</h3>
          <p>{guide.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
