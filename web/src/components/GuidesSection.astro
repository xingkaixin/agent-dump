---
import { getGuides, guideIndexPaths, guideUi } from "../lib/guides";
import type { Locale } from "../lib/i18n";
import Icon from "./Icon.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = guideUi[locale];
const guides = await getGuides(locale);
---

<section id="guides" class="sec">
  <div class="wrap">
    <div class="shead" data-reveal>
      <div>
        <p class="eyebrow"><span class="ix">06</span><span class="ln"></span>{t.label}</p>
        <h2 class="h2">{t.title}</h2>
      </div>
      <div class="shead-side">
        <p class="sub">{t.description}</p>
        <a href={guideIndexPaths[locale]} class="tlink">
          {t.all}
          <Icon name="arrowRight" small />
        </a>
      </div>
    </div>
    <div class="ggrid">
      {guides.map((guide, index) => (
        <div class="gwrap" data-reveal>
          <a href={guide.href} class="gtile">
            <span class="gmeta">
              <span>0{index + 1} · {t.categories[guide.category]}</span>
              <Icon name="arrowRight" />
            </span>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
