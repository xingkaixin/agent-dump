---
import { ArrowUpRightIcon } from "@phosphor-icons/react";
import { site, ui, type Locale } from "../lib/i18n";
import ReleaseEntry from "./ReleaseEntry.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const older = {
  en: "Earlier releases",
  zh: "更早的版本",
  ja: "以前のリリース",
};
---

<section id="updates" aria-labelledby="updates-heading" class="updates-section">
  <div class="shell">
    <div data-reveal class="section-heading">
      <h2 id="updates-heading">{t.updatesHeading}</h2>
      <p>{t.updatesSubheading}</p>
    </div>
    <div class="updates-grid" data-reveal>
      {t.updates.slice(0, 3).map((update, index) => (
        <ReleaseEntry update={update} featured={index === 0} />
      ))}
    </div>
    <details class="release-archive">
      <summary>
        {older[locale]} ({t.updates.length - 3})
      </summary>
      <div class="updates-grid">
        {t.updates.slice(3).map((update) => (
          <ReleaseEntry update={update} />
        ))}
      </div>
    </details>
    <div class="updates-link">
      <a
        href={site.changelogUrl[locale]}
        target="_blank"
        rel="noopener noreferrer"
        class="text-link"
      >
        {t.viewFullChangelog}
        <ArrowUpRightIcon size={18} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
