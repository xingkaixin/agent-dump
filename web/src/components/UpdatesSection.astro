---
import { site, ui, type Locale } from "../lib/i18n";
import { landing } from "../lib/landing";
import Icon from "./Icon.astro";
import ReleaseEntry from "./ReleaseEntry.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const l = landing[locale];
const [latest, ...rest] = t.updates;
const recent = rest.slice(0, 2);
const older = rest.slice(2);
---

<section id="updates" aria-labelledby="updates-heading" class="sec">
  <div class="wrap">
    <div class="shead" data-reveal>
      <div>
        <h2 class="h2" id="updates-heading">{t.updatesHeading}</h2>
      </div>
      <div class="shead-side">
        <p class="sub">{t.updatesSubheading}</p>
        <a
          href={site.changelogUrl[locale]}
          target="_blank"
          rel="noopener noreferrer"
          class="tlink"
        >
          {t.viewFullChangelog}
          <Icon name="arrowUpRight" small />
        </a>
      </div>
    </div>
    <article class="feat dots" data-reveal>
      <div>
        <p class="badge">
          <span class="pdot"></span>{l.updates.latest} · <time datetime={latest.date}>{latest.date}</time>
        </p>
        <p class="vbig">{latest.version}</p>
      </div>
      <div>
        <h3>{latest.title}</h3>
        <p class="ds">{latest.description}</p>
        <div class="tags">
          {latest.tags.map((tag) => <span>{tag}</span>)}
        </div>
        {latest.command && (
          <code class="cline"><b>$ </b>{latest.command}</code>
        )}
      </div>
    </article>
    <div class="rgrid">
      {recent.map((update) => <ReleaseEntry update={update} />)}
    </div>
    <details class="arch" data-reveal>
      <summary>
        <span>{l.updates.older}</span>
        <span class="rng">
          {older.length} · {older.at(-1)?.version} – {older[0]?.version}
        </span>
        <Icon name="chevronDown" />
      </summary>
      <ol class="alist">
        {older.map((update, index) => (
          <li style={`--i: ${index}`}>
            <span class="av">{update.version}</span>
            <time datetime={update.date}>{update.date}</time>
            <span>{update.title}</span>
          </li>
        ))}
      </ol>
    </details>
  </div>
</section>
