---
import { install, site, ui, type Locale } from "../lib/i18n";
import { InstallTabs } from "./InstallTabs";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const groups = [
  { label: install.globalLabel[locale], tabs: install.global },
  { label: install.runLabel[locale], tabs: install.run },
];
---

<section id="install" class="install-section">
  <div class="shell install-layout">
    <div data-reveal class="section-heading">
      <h2>
        {t.installHeading}
      </h2>
      <p>{t.installNote}</p>
    </div>

    <div data-reveal class="install-panel">
      <InstallTabs
        client:visible
        groups={groups}
        skill={{ note: t.skillNote, command: site.skillCommand }}
        copy={t.copy}
        copied={t.copied}
      />
    </div>
  </div>
</section>
