---
import { install, site, ui, type Locale } from "../lib/i18n";
import { InstallPicker } from "./InstallPicker";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const groups = [
  {
    label: install.nativeLabel[locale],
    methods: install.native.map(({ note, ...method }) => ({ ...method, note: note[locale] })),
  },
  { label: install.globalLabel[locale], methods: install.global },
  { label: install.runLabel[locale], methods: install.run },
];
const platforms = ["macOS Intel / Apple Silicon", "Linux x64", "Windows x64"];
---

<section id="install" class="sec panel dots">
  <div class="wrap inst">
    <div data-reveal>
      <h2 class="inst-h">{t.installHeading}</h2>
      <p class="sub" style="margin-top: 20px">{t.installNote}</p>
      <div class="plats">
        {platforms.map((platform) => <span class="plat"><i></i>{platform}</span>)}
      </div>
    </div>
    <div data-reveal>
      <InstallPicker
        client:visible
        groups={groups}
        skill={{ note: t.skillNote, command: site.skillCommand }}
        copy={t.copy}
        copied={t.copied}
      />
    </div>
  </div>
</section>
