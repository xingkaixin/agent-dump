---
import { install, site, ui, type Locale } from "../lib/i18n";
import { InstallPicker } from "./InstallPicker";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];

const groups = [
  {
    label: install.nativeLabel[locale],
    methods: install.native.map(({ note, ...method }) => ({ ...method, note: note[locale] })),
  },
  { label: install.globalLabel[locale], methods: install.global },
  { label: install.runLabel[locale], methods: install.run },
];
---

<section id="install" class="install-section grid-backdrop">
  <div class="shell install-layout">
    <div class="install-head" data-reveal>
      <h2>{t.installHeading}</h2>
      <p>{t.installNote}</p>
    </div>
    <div data-reveal>
      <InstallPicker
        client:visible
        groups={groups}
        skill={{ note: t.skillNote, command: site.skillCommand }}
        copy={t.copy}
        copied={t.copied}
      />
    </div>
  </div>
</section>
