---
import type { Locale } from "../lib/i18n";
import { landing } from "../lib/landing";
import { BrowseDemo } from "./BrowseDemo";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const l = landing[locale];
---

<section id="browse" class="browse-section">
  <div class="shell">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">agent-dump --browse</p>
        <h2>{l.browse.heading}</h2>
      </div>
      <p>{l.browse.summary}</p>
    </div>
    <div data-reveal>
      <BrowseDemo
        client:visible
        lang={locale === "zh" ? "zh" : "en"}
        copy={l.browse}
      />
    </div>
  </div>
</section>
