---
import type { Locale } from "../lib/i18n";
import { landing } from "../lib/landing";
import { BrowseDemo } from "./BrowseDemo";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const l = landing[locale];
---

<section id="browse" class="sec">
  <div class="wrap">
    <div class="shead" data-reveal>
      <div>
        <h2 class="h2">{l.browse.heading}</h2>
      </div>
      <p class="sub">{l.browse.summary}</p>
    </div>
    <div data-reveal>
      <BrowseDemo
        client:visible
        lang={locale === "zh" ? "zh" : "en"}
        copy={l.browse}
      />
    </div>
  </div>
</section>
