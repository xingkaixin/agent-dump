---
import { ListIcon, MoonIcon, SunIcon } from "@phosphor-icons/react";
import { guideIndexPaths, guideUi } from "../lib/guides";
import { LOCALES, localeLabels, site, ui, type Locale } from "../lib/i18n";
import { landing } from "../lib/landing";

interface Props {
  locale: Locale;
  paths?: Partial<Record<Locale, string>>;
  homeLinks?: boolean;
}
const { locale, paths = site.paths, homeLinks = false } = Astro.props;
const home = homeLinks ? site.paths[locale] : "";
const t = ui[locale];
const l = landing[locale];
const links = [
  { href: `${home}#capabilities`, label: t.capabilitiesHeading },
  { href: `${home}#browse`, label: l.nav.browse },
  { href: guideIndexPaths[locale], label: guideUi[locale].label },
  { href: `${home}#updates`, label: t.updatesHeading },
  { href: `${home}#faq`, label: l.nav.faq },
];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a href={site.paths[locale]} class="site-brand" aria-label="agent-dump">
      <img
        src={site.logo}
        alt=""
        width="26"
        height="26"
        class="rounded-[var(--radius-xs)]"
      />
      <span>agent-dump</span>
    </a>

    <nav
      class="site-nav"
      aria-label={
        locale === "zh"
          ? "主导航"
          : locale === "ja"
            ? "メインナビゲーション"
            : "Primary"
      }
    >
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a
        href={`${home}#install`}
        class="button button--primary site-nav__cta"
        data-umami-event="install-cta"
        data-umami-event-location="header"
        data-umami-event-locale={t.htmlLang}>{t.installHeading}</a
      >
    </nav>

    <div class="site-tools">
      <div role="group" aria-label={t.langLabel} class="language-switcher">
        {LOCALES.filter((code) => paths[code]).map((code) => {
          const current = code === locale;
          return (
            <a
              href={paths[code]}
              lang={ui[code].htmlLang}
              data-locale-choice={code}
              aria-current={current ? "page" : undefined}
              class:list={[
                "language-switcher__link",
                current && "language-switcher__link--active",
              ]}
            >
              {localeLabels[code]}
            </a>
          );
        })}
      </div>

      <button
        type="button"
        data-theme-toggle
        aria-label={t.themeLabel}
        title={t.themeLabel}
        class="icon-button theme-toggle"
      >
        <span class="theme-toggle__icons">
          <SunIcon weight="bold" aria-hidden="true" className="theme-toggle__sun" />
          <MoonIcon weight="bold" aria-hidden="true" className="theme-toggle__moon" />
        </span>
      </button>

      <details class="mobile-menu">
        <summary class="icon-button" aria-label={l.menu}>
          <ListIcon size={20} aria-hidden="true" />
        </summary>
        <nav
          aria-label={
            locale === "zh"
              ? "移动导航"
              : locale === "ja"
                ? "モバイルメニュー"
                : "Mobile navigation"
          }
        >
          {links.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={site.repo}>GitHub</a>
          <a
            href={`${home}#install`}
            class="button button--primary"
            data-umami-event="install-cta"
            data-umami-event-location="mobile-nav"
            data-umami-event-locale={t.htmlLang}>{t.installHeading}</a
          >
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelectorAll(".mobile-menu").forEach(function (menu) {
    menu.addEventListener("click", function (event) {
      if (event.target.closest("a")) menu.open = false;
    });
    menu.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        menu.open = false;
        menu.querySelector("summary").focus();
      }
    });
  });
  document.querySelectorAll("[data-locale-choice]").forEach(function (link) {
    link.addEventListener("click", function () {
      try {
        localStorage.setItem("agent-dump-locale", link.dataset.localeChoice);
      } catch (e) {}
    });
  });
  document.querySelectorAll("[data-theme-toggle]").forEach(function (button) {
    button.addEventListener("click", function () {
      var root = document.documentElement;
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta)
        meta.setAttribute("content", next === "dark" ? "#0c1011" : "#f1f3ef");
      try {
        localStorage.setItem("agent-dump-theme", next);
      } catch (e) {}
    });
  });
</script>
