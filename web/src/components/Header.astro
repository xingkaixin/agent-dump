---
import { ListIcon, MoonIcon, SunIcon } from "@phosphor-icons/react";
import { guideIndexPaths, guideUi } from "../lib/guides";
import { LOCALES, localeLabels, site, ui, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  paths?: Partial<Record<Locale, string>>;
  homeLinks?: boolean;
}
const { locale, paths = site.paths, homeLinks = false } = Astro.props;
const home = homeLinks ? site.paths[locale] : "";
const t = ui[locale];
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a href={site.paths[locale]} class="site-brand" aria-label="agent-dump">
      <img
        src={site.logo}
        alt=""
        width="26"
        height="26"
        class="rounded-[var(--radius-xs)]"
      />
      <span>agent-dump</span>
    </a>

    <nav
      class="site-nav"
      aria-label={
        locale === "zh"
          ? "主导航"
          : locale === "ja"
            ? "メインナビゲーション"
            : "Primary"
      }
    >
      <a href={guideIndexPaths[locale]}>{guideUi[locale].label}</a>
      <a href={`${home}#capabilities`}>{t.capabilitiesHeading}</a>
      <a href={`${home}#updates`}>{t.updatesHeading}</a>
      <a href={`${home}#install`}>{t.installHeading}</a>
    </nav>

    <div class="site-tools">
      <details class="mobile-menu">
        <summary
          aria-label={
            locale === "zh"
              ? "导航菜单"
              : locale === "ja"
                ? "メニュー"
                : "Navigation menu"
          }
        >
          <ListIcon size={20} aria-hidden="true" />
        </summary>
        <nav
          aria-label={
            locale === "zh"
              ? "移动导航"
              : locale === "ja"
                ? "モバイルメニュー"
                : "Mobile navigation"
          }
        >
          <a href={guideIndexPaths[locale]}>{guideUi[locale].label}</a>
          <a href={`${home}#capabilities`}>{t.capabilitiesHeading}</a>
          <a href={`${home}#updates`}>{t.updatesHeading}</a>
          <a href={`${home}#install`}>{t.installHeading}</a>
        </nav>
      </details>
      <div role="group" aria-label={t.langLabel} class="language-switcher">
        {LOCALES.filter((code) => paths[code]).map((code) => {
          const current = code === locale;
          return (
            <a
              href={paths[code]}
              lang={ui[code].htmlLang}
              aria-current={current ? "page" : undefined}
              class:list={[
                "language-switcher__link",
                current
                  ? "language-switcher__link--active"
                  : "language-switcher__link--idle",
              ]}
            >
              {localeLabels[code]}
            </a>
          );
        })}
      </div>

      <div class="size-9 shrink-0">
        <button
          type="button"
          data-theme-toggle
          aria-label={t.themeLabel}
          title={t.themeLabel}
          class="theme-toggle"
        >
          <span class="relative block size-[18px]">
            <SunIcon
              weight="bold"
              aria-hidden="true"
              className="absolute inset-0 size-[18px] transition-[opacity,transform] duration-200 ease-out dark:scale-60 dark:-rotate-90 dark:opacity-0"
            />
            <MoonIcon
              weight="bold"
              aria-hidden="true"
              className="absolute inset-0 size-[18px] rotate-90 scale-60 text-accent opacity-0 transition-[opacity,transform] duration-200 ease-out dark:rotate-0 dark:scale-100 dark:opacity-100"
            />
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelectorAll(".mobile-menu").forEach(function (menu) {
    menu.addEventListener("click", function (event) {
      if (event.target.closest("a")) menu.open = false;
    });
    menu.addEventListener("keydown", function (event) {
      if (event.key === "Escape") {
        menu.open = false;
        menu.querySelector("summary").focus();
      }
    });
  });
  document.querySelectorAll("[data-theme-toggle]").forEach(function (button) {
    button.addEventListener("click", function () {
      var root = document.documentElement;
      var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta)
        meta.setAttribute("content", next === "dark" ? "#0c1011" : "#f1f3ef");
      try {
        localStorage.setItem("agent-dump-theme", next);
      } catch (e) {}
    });
  });
</script>
