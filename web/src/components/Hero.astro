---
import { ArrowDownIcon, GithubLogoIcon } from "@phosphor-icons/react";
import { providers, site, ui, type Locale } from "../lib/i18n";
import FocusScene from "./FocusScene.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="hero" class="shell hero-section">
  <div class="hero-grid">
    <div data-reveal class="hero-copy">
      <p class="hero-eyebrow">
        {t.eyebrow}
      </p>
      <h1 class="hero-title">
        {t.heroTitle}{" "}
        <span>{t.heroTitleAccent}</span>
      </h1>
      <p class="hero-description">
        {t.heroDescription}
      </p>
      <div class="hero-actions">
        <a
          href="#install"
          class="button button--primary"
        >
          {t.ctaInstall}
          <ArrowDownIcon className="size-4" aria-hidden="true" />
        </a>
        <a
          href={site.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="button button--secondary"
        >
          <GithubLogoIcon className="size-4" aria-hidden="true" />
          {t.ctaSource}
        </a>
      </div>
    </div>

    <div data-reveal class="hero-visual" style="--reveal-delay: 120ms">
      <FocusScene caption={t.providersHeading} sources={providers.map((provider) => provider.name)} />
    </div>
  </div>
</section>
