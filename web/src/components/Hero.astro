---
import heroBgAvif from "../assets/hero-bg.avif?url";
import heroBgWebp from "../assets/hero-bg.webp?url";
import { ui, type Locale } from "../lib/i18n";
import { landing } from "../lib/landing";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const l = landing[locale];
const quickCmd = "npx @agent-dump/cli --help";
const hits = l.stage.hitsList;
const firstHit = hits[0];
const sources = [
  { name: "Claude Code", count: "142", active: true },
  { name: "Codex", count: "96", active: true },
  { name: "Cursor", count: "64", active: true },
  { name: "OpenCode", count: "31" },
  { name: "Gemini CLI", count: "28" },
  { name: "Pi / Antigravity", count: "47" },
  { name: l.stage.moreProviders, count: "89" },
];
const titleJoined = locale === "en" ? `${t.heroTitle} ` : t.heroTitle;
---

<section id="hero" class="hero">
  <picture class="hero-bg" aria-hidden="true">
    <source srcset={heroBgAvif} type="image/avif" />
    <img
      src={heroBgWebp}
      alt=""
      width="1664"
      height="936"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1 class="h1 rise">
        {titleJoined}<span class="hero-accent">{t.heroTitleAccent}</span>
      </h1>
      <p class="hero-lede rise" style="animation-delay: 0.08s">
        {t.heroDescription}
      </p>
      <div class="hero-acts rise" style="animation-delay: 0.16s">
        <a
          href="#install"
          class="btn btn-key"
          data-umami-event="install-cta"
          data-umami-event-location="hero"
          data-umami-event-locale={t.htmlLang}
        >
          {t.ctaInstall}
          <Icon name="arrowDown" />
        </a>
        <div class="hero-cmd">
          <span class="hero-cmd-sig" aria-hidden="true">$</span>
          <code>{quickCmd}</code>
          <button
            type="button"
            class="hero-cmd-copy"
            data-quick-copy={quickCmd}
            data-install-method="npx"
            data-copy-label={t.copy}
            data-copied-label={t.copied}
            aria-label={t.copy}
          >
            {t.copy}
          </button>
          <span role="status" aria-live="polite" class="sr-only" data-copy-status></span>
        </div>
      </div>
    </div>

    <div class="hero-stage rise" style="animation-delay: 0.22s">
      <div class="workbench" role="region" aria-label={l.stage.sample} data-hero-workbench>
        <div class="wb-bar">
          <div class="wb-left">
            <span class="wb-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="wb-title">agent-dump</span>
            <span class="wb-meta">{l.stage.meta}</span>
          </div>
          <span class="wb-readonly">{l.stage.untouched}</span>
        </div>

        <div class="wb-body">
          <aside class="wb-sources" aria-hidden="true">
            <div class="wb-col-head">{l.stage.sources}</div>
            {sources.map((src) => (
              <div class:list={["src-row", src.active && "active"]}>
                <span>{src.name}</span>
                <span class="src-count">{src.count}</span>
              </div>
            ))}
          </aside>

          <div class="wb-shell">
            <div class="wb-cmd">
              <span class="tok" aria-hidden="true">$</span>
              <span>agent-dump search "auth timeout" --days 30</span>
            </div>
            <div class="wb-hits" role="tablist" aria-label={l.stage.sample}>
              {hits.map((hit, index) => (
                <button
                  type="button"
                  role="tab"
                  class:list={["wb-hit", index === 0 && "selected"]}
                  aria-selected={index === 0 ? "true" : "false"}
                  data-hit-uri={hit.uri}
                  data-hit-loc={hit.loc.replace(" ", "-")}
                  data-hit-file={hit.file}
                  data-hit-user={hit.user}
                  data-hit-assistant={hit.assistant}
                >
                  <span class="wb-hit-uri">
                    <span>{hit.uri}</span>
                    <span class="wb-hit-meta">{hit.loc} · {hit.age}</span>
                  </span>
                  <span class="wb-hit-snip">
                    {hit.lead}<mark>{hit.match}</mark>{hit.tail}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <div class="wb-output" aria-live="polite">
            <div class="wb-out-head">
              <span class="tam">export · markdown</span>
              <strong data-wb-uri>{firstHit.uri}</strong>
            </div>
            <div class="wb-out-doc">
              <div class="wb-out-meta" data-wb-source>
                source: {firstHit.uri}#{firstHit.loc.replace(" ", "-")}
              </div>
              <p>
                <strong>User:</strong>{" "}
                <span data-wb-user>{firstHit.user}</span>
              </p>
              <p>
                <strong>Assistant:</strong>{" "}
                <span data-wb-assistant>{firstHit.assistant}</span>
              </p>
            </div>
            <div class="wb-out-foot">
              <Icon name="check" small />
              <span>{l.stage.written} <span data-wb-file>{firstHit.file}</span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { copyText } from "../lib/clipboard";
  import { trackEvent } from "../lib/analytics";

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-quick-copy]")) {
    let timer = 0;
    btn.addEventListener("click", async () => {
      const text = btn.dataset.quickCopy ?? "";
      const copyLabel = btn.dataset.copyLabel ?? "Copy";
      const copiedLabel = btn.dataset.copiedLabel ?? "Copied";
      try {
        if (!(await copyText(text))) return;
        btn.textContent = copiedLabel;
        btn.classList.add("ok");
        btn.setAttribute("aria-label", copiedLabel);
        const status = btn.nextElementSibling;
        if (status?.hasAttribute("data-copy-status")) {
          status.textContent = copiedLabel;
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = copyLabel;
          btn.classList.remove("ok");
          btn.setAttribute("aria-label", copyLabel);
          if (status?.hasAttribute("data-copy-status")) {
            status.textContent = "";
          }
        }, 1600);
        const method = btn.dataset.installMethod;
        if (method) trackEvent("install-copy", { method, location: "hero" });
      } catch {
        /* clipboard unavailable */
      }
    });
  }

  for (const wb of document.querySelectorAll<HTMLElement>("[data-hero-workbench]")) {
    const tabs = Array.from(wb.querySelectorAll<HTMLButtonElement>("[data-hit-uri]"));
    const uriEl = wb.querySelector<HTMLElement>("[data-wb-uri]");
    const srcEl = wb.querySelector<HTMLElement>("[data-wb-source]");
    const userEl = wb.querySelector<HTMLElement>("[data-wb-user]");
    const asstEl = wb.querySelector<HTMLElement>("[data-wb-assistant]");
    const fileEl = wb.querySelector<HTMLElement>("[data-wb-file]");

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        for (const other of tabs) {
          const active = other === tab;
          other.classList.toggle("selected", active);
          other.setAttribute("aria-selected", String(active));
        }
        const uri = tab.dataset.hitUri ?? "";
        const loc = tab.dataset.hitLoc ?? "";
        if (uriEl) uriEl.textContent = uri;
        if (srcEl) srcEl.textContent = `source: ${uri}#${loc}`;
        if (userEl) userEl.textContent = tab.dataset.hitUser ?? "";
        if (asstEl) asstEl.textContent = tab.dataset.hitAssistant ?? "";
        if (fileEl) fileEl.textContent = tab.dataset.hitFile ?? "";
      });
    }
  }
</script>
