---
import { install, providers, ui, type Locale } from "../lib/i18n";
import { guideIndexPaths, guideUi } from "../lib/guides";
import { landing } from "../lib/landing";
import { version } from "../lib/version";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const l = landing[locale];
type Line = { text: string; kind?: string; hit?: boolean; count?: string; after?: string };
const screens: { command: string; lines: Line[] }[] = [
  {
    command: "agent-dump search 'auth timeout'",
    lines: [
      { text: l.stage.hits, kind: "tm" },
      { text: "claude://7f3c91 · msg 14", hit: true },
      { text: "codex://019a7c2e · msg 3", hit: true },
      { text: "cursor://b21e04 · msg 1", hit: true },
    ],
  },
  {
    command: "agent-dump export codex://019a7c2e",
    lines: [
      { text: "--format markdown --output ./sessions", kind: "tm" },
      { text: "reading", count: "38", after: "messages" },
      { text: `ok · ${l.stage.untouched}`, kind: "tok" },
    ],
  },
  {
    command: "agent-dump collect --days 7",
    lines: [
      { text: "--emit-prompt --save ./reports/weekly.md", kind: "tm" },
      { text: "chunked · every eligible message" },
      { text: "status: complete", kind: "tok" },
    ],
  },
];
const papers = [
  {
    kind: "HITS + LOCATORS",
    label: "auth timeout",
    bars: [[86, true], [64], [72, true]],
    cls: "pa",
    t: "rotate(-7deg) translate(-78px, -26px)",
  },
  {
    kind: "MARKDOWN",
    label: `${l.sample.s2}.md`,
    bars: [[92], [70], [54]],
    cls: "pb",
    t: "rotate(4deg) translate(-26px, -10px)",
    stamp: true,
  },
  {
    kind: "AGENT PROMPT",
    label: l.stage.handoff,
    bars: [[80], [60, true], [74]],
    cls: "pc",
    t: "rotate(-2deg)",
  },
];
---

<section id="hero" class="hero dots">
  <div class="wrap hero-grid">
    <div>
      <p class="pill rise">
        <span class="ver">v{version}</span><span class="pdot"></span>{t.eyebrow}
      </p>
      <h1 class="h1 rise" style="animation-delay: 0.08s">
        {t.heroTitle}<br /><span class="mk">{t.heroTitleAccent}</span>
      </h1>
      <p class="hero-lede rise" style="animation-delay: 0.16s">
        {t.heroDescription}
      </p>
      <div class="hero-acts rise" style="animation-delay: 0.24s">
        <a
          href="#install"
          class="btn btn-key"
          data-umami-event="install-cta"
          data-umami-event-location="hero"
          data-umami-event-locale={t.htmlLang}
        >
          {t.ctaInstall}
          <Icon name="arrowDown" />
        </a>
        <a href={guideIndexPaths[locale]} class="btn btn-ghost">
          {guideUi[locale].label}
          <Icon name="arrowUpRight" />
        </a>
      </div>
      <p class="hero-quick rise" style="animation-delay: 0.32s">
        <span>{install.runLabel[locale]}</span><code>npx @agent-dump/cli --help</code>
      </p>
    </div>

    <div class="hv rise" style="animation-delay: 0.2s" aria-hidden="true">
      <svg class="arrow" viewBox="64 12 44 51">
        <path
          d="M 78 15 L 78 40 L 68 40 L 86 60 L 104 40 L 94 40 L 94 15 Z"
          fill="#4ade80"
          stroke="#166534"
          stroke-width="2.5"
          stroke-linejoin="round"></path>
      </svg>
      <div class="term">
        <div class="term-bar">
          <span class="tab"><span class="prompt-mark">&gt;_</span>{l.stage.sample}</span>
          <span>zsh</span>
        </div>
        <div class="hv-body">
          <ul class="srcs">
            <li class="lab">{l.stage.sources}</li>
            {providers.map((provider, index) => (
              <li style={`animation-delay: ${index * 0.5}s`}>
                <i></i>{provider.name}
              </li>
            ))}
          </ul>
          <div class="hv-shell">
            {screens.map((screen, index) => (
              <div class="scr">
                <div class="cmd">
                  <span class="tok">$</span>
                  <span class="typ" style={`--w: ${screen.command.length}ch`}>
                    {screen.command}
                  </span>
                  <span class="caret"></span>
                </div>
                {screen.lines.map((line, row) => (
                  <div
                    class:list={["o", line.kind]}
                    style={`animation-delay: ${(index * 3 + 1.2 + row * 0.25).toFixed(2)}s`}
                  >
                    {line.hit && <span class="tok">› </span>}
                    {line.text}
                    {line.count && (
                      <>
                        {" "}<span class="tam">{line.count}</span> {line.after}
                      </>
                    )}
                  </div>
                ))}
              </div>
            ))}
            <p class="shell-foot">read-only · --json · cursor paging</p>
          </div>
        </div>
      </div>
      <div class="papers">
        {papers.map((paper) => (
          <div class={`paper ${paper.cls}`} style={`--t: ${paper.t}`}>
            <p class="k">{paper.kind}</p>
            <p class="n">{paper.label}</p>
            <div class="bars">
              {paper.bars.map(([width, hl]) => (
                <span class:list={[hl && "hl"]} style={`width: ${width}%`}></span>
              ))}
            </div>
            {paper.stamp && <span class="stamp">{l.stage.untouched}</span>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
