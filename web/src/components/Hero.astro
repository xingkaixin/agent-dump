---
import { Image } from "astro:assets";
import { ArrowDownIcon, ArrowUpRightIcon } from "@phosphor-icons/react";
import { ui, type Locale } from "../lib/i18n";
import { guideIndexPaths, guideUi } from "../lib/guides";
import paper from "../assets/editorial/session-paper.png";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="hero" class="shell hero-section">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow">{t.eyebrow}</p>
      <h1 class="hero-title">
        {t.heroTitle} <span>{t.heroTitleAccent}</span>
      </h1>
      <p class="hero-description">{t.heroDescription}</p>
      <div class="hero-actions">
        <a href="#install" class="button button--primary" data-umami-event="install-cta" data-umami-event-location="hero" data-umami-event-locale={t.htmlLang}>
          {t.ctaInstall}
          <ArrowDownIcon size={18} aria-hidden="true" />
        </a>
        <a href={guideIndexPaths[locale]} class="button button--text">
          {guideUi[locale].label}
          <ArrowUpRightIcon size={18} aria-hidden="true" />
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <Image
        src={paper}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(max-width: 767px) 100vw, 50vw"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero-art"
      />
    </div>
  </div>
</section>
