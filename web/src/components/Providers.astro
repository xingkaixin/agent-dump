---
import { ArrowUpRightIcon } from "@phosphor-icons/react";
import { site, ui, providers, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
---

<section id="providers" class="providers-section">
  <div class="shell">
    <div data-reveal class="section-heading">
      <h2>
        {t.providersHeading}
      </h2>
      <p>{t.providersNote}</p>
    </div>

    <div class="provider-scroll" data-reveal>
      <ul class="provider-track">
        {
          providers.map((provider, index) => (
            <li class="provider-stop" style={`--provider-index: ${index}`}>
              <span class="provider-name">{provider.name}</span>
              <code>{provider.example}</code>
            </li>
          ))
        }
        <li class="provider-stop provider-stop--more">
          <a
            href={`${site.repo}/pulls`}
            target="_blank"
            rel="noopener noreferrer"
            class="group no-underline"
          >
            <span class="provider-name">{t.moreTools.title}</span>
            <span class="provider-link">
              {t.moreTools.note}
              <ArrowUpRightIcon className="size-3.5" aria-hidden="true" />
            </span>
          </a>
        </li>
      </ul>
    </div>

  </div>
</section>
