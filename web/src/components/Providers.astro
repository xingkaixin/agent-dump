---
import { ArrowRightIcon, ArrowUpRightIcon } from "@phosphor-icons/react";
import { codexGuideLinks } from "../lib/guides";
import { site, ui, providers, type Locale } from "../lib/i18n";
import { landing } from "../lib/landing";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui[locale];
const l = landing[locale];
---

<section id="providers" class="providers-section">
  <div class="shell section-head" data-reveal>
    <h2>{t.providersHeading}</h2>
    <p>{t.providersNote}</p>
  </div>
  <div class="marquee" data-reveal>
    {[0, 1].map((copy) => (
      <ul class="marquee__track" aria-hidden={copy === 1 ? "true" : undefined}>
        {providers.map((provider) => (
          <li>
            <span>{provider.name}</span>
            <code>{provider.example}</code>
          </li>
        ))}
      </ul>
    ))}
  </div>
  <div class="shell provider-links">
    <a class="text-link" href={codexGuideLinks[locale].href}>
      {l.codexGuide}
      <ArrowRightIcon size={16} aria-hidden="true" />
    </a>
    <a
      class="text-link"
      href={`${site.repo}/pulls`}
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.moreTools.title} · {t.moreTools.note}
      <ArrowUpRightIcon size={16} aria-hidden="true" />
    </a>
  </div>
</section>
