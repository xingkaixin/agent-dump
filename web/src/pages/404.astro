---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import "../styles/guides.css";
---

<Base
  locale="en"
  noindex
  page={{
    title: "Page not found | Agent Dump",
    description: "This page could not be found. Find Agent Dump installation options and guides.",
    paths: { en: "/404/" },
  }}
>
  <Header locale="en" homeLinks />
  <main id="main" tabindex="-1" class="lost dots">
    <div class="wrap">
      <p class="eyebrow"><span class="ix">404</span><span class="ln"></span>Not found</p>
      <h1 class="gh1">Page not found</h1>
      <p class="gdesc">The page may have moved, or the address may be incorrect.</p>
      <a class="tlink" href="/guides/">Browse the guides <Icon name="arrowRight" small /></a>
    </div>
  </main>
  <Footer locale="en" />
</Base>
